{
  "name": "quickzy-desktop",
  "productName": "Quickzy",
  "version": "1.3.0",
  "description": "Quickzy for Windows: play quizzes anywhere, even with no internet.",
  "main": "main.cjs",
  "author": "Quickzy",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.web.quickzy",
    "productName": "Quickzy",
    "copyright": "Quickzy",
    "files": [
      "main.cjs",
      "site/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icon.png",
      "target": "nsis",
      "artifactName": "Quickzy-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quickzy",
      "runAfterFinish": true
    }
  }
}
