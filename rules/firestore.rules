rules_version = '2';

// Firestore: accounts, quizzes and game reports.
//
// The guiding rules:
//   * you can only ever change what is yours;
//   * guests (anonymous players) can read public things and nothing else;
//   * a quiz's answers live in a separate document that players never see.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // 2-step verification: once it is on (mfa/{uid}, written only by the
    // sign-in guard), a session that did not pass the code changes nothing
    function needsCode() {
      return exists(/databases/$(database)/documents/mfa/$(request.auth.uid))
        && get(/databases/$(database)/documents/mfa/$(request.auth.uid)).data.on == true
        && request.auth.token.get('mfa', false) != true;
    }
    // "Sign out everywhere": a device that last proved who it is before that
    // moment can no longer change anything, even with a stolen session
    function lockedOut() {
      return exists(/databases/$(database)/documents/signouts/$(request.auth.uid))
        && get(/databases/$(database)/documents/signouts/$(request.auth.uid)).data.before > request.auth.token.auth_time * 1000;
    }
    function account() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous' && !lockedOut() && !needsCode(); }
    function me(uid) { return signedIn() && request.auth.uid == uid && !needsCode(); }
    function onlyKeys(keys) { return request.resource.data.keys().hasOnly(keys); }
    function str(v, max) { return v is string && v.size() <= max; }
    // the person who runs Quickzy; the same account carries the green check
    function siteOwner() { return signedIn() && request.auth.uid == 'KWIRRSUM2VQVWnr1nUDbPP9bqMk2'; }
    // the owner can stop an account from publishing
    function banned() { return exists(/databases/$(database)/documents/bans/$(request.auth.uid)); }
    // Pro members (the owner and the official account always are)
    function pro() { return signedIn() && proUid(request.auth.uid); }
    function proUid(u) {
      // the free test is over: the owner, the official account and ugemnomads
      return u == 'KWIRRSUM2VQVWnr1nUDbPP9bqMk2' || u == 'XH9Z5D7tLmRHStlxumgaJyTo1BP2'
        || u == 'f4BZrMpjQnV2B7n3iKq68J8poJ63'
        || (exists(/databases/$(database)/documents/members/$(u))
            && get(/databases/$(database)/documents/members/$(u)).data.until > request.time.toMillis());
    }
    // classes: free teachers have 2 (ids uid_1 and uid_2) of up to 100 students; Pro more
    function roomFor(owner, n) { return n <= 100 || (n <= 300 && proUid(owner)); }

    // ------------------------------------------------------ sign out everywhere
    // the moment every older sign-in stops working; only the account itself
    // sets it, and only to the moment it last proved who it is
    // whether an account has 2-step on: the account itself may read it
    match /mfa/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /signouts/{uid} {
      allow read: if me(uid);
      allow create, update: if me(uid) && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['before'])
        && request.resource.data.before == request.auth.token.auth_time * 1000;
    }

    // ------------------------------------------------------------ profiles
    // Public: display name, username, blook. No email is ever stored here.
    match /users/{uid} {
      // Blooks: one at a time, never taken away; a blook you don't have yet
      // costs a box (15+ coins), except the Buddy for inviting a friend
      function blooksOk(o0, o1, c0, c1) {
        let changed = o1.diff(o0).affectedKeys();
        return changed.size() == 0
          || (changed.size() == 1 && o1.keys().hasAll(o0.keys())
              && (c1 <= c0 - 15 || changed.hasOnly(['buddy']) || o0.keys().hasAll(changed)));
      }
      // XP only grows, by one game's worth at a time, and only once per game;
      // coins never go below zero; three custom blooks at most
      function progressOk() {
        let before = resource.data;
        let after = request.resource.data;
        let xp0 = before.get('xp', 0);
        let xp1 = after.get('xp', 0);
        return xp1 is int && xp1 >= xp0 && xp1 - xp0 <= 400
          && (xp1 == xp0 || after.get('lastGame', '') != before.get('lastGame', ''))
          && after.get('coins', 0) is int && after.get('coins', 0) >= 0
          && after.get('coins', 0) - before.get('coins', 0) <= 150
          // coins can only go up once every 15 seconds (stops scripts farming them);
          // the moment is stamped by the server, so it can't be faked
          && (after.get('coins', 0) <= before.get('coins', 0)
              || (after.get('coinAt', null) == request.time
                  && (!('coinAt' in before) || before.coinAt < request.time - duration.value(15, 's'))))
          && (!('coinAt' in after) || after.coinAt == before.get('coinAt', null) || after.coinAt == request.time)
          // XP only comes with a game's coins (so it shares their 15-second gap)
          && (xp1 == xp0 || after.get('coins', 0) > before.get('coins', 0))
          && blooksOk(before.get('owned', {}), after.get('owned', {}), before.get('coins', 0), after.get('coins', 0))
          && after.get('owned', {}).size() <= 40
          && after.get('customs', []).size() <= 3
          && str(after.get('lastGame', ''), 40);
      }
      allow read: if true;
      allow create: if me(uid) && account()
        && onlyKeys(['username', 'displayName', 'blook', 'createdAt', 'xp', 'coins', 'owned', 'customs'])
        && request.resource.data.get('xp', 0) == 0
        && request.resource.data.get('coins', 0) <= 50
        && request.resource.data.get('owned', {}).size() == 0
        && request.resource.data.get('customs', []).size() == 0
        && str(request.resource.data.displayName, 30) && request.resource.data.displayName.size() > 0
        && str(request.resource.data.blook, 20)
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow update: if me(uid)
        && onlyKeys(['username', 'displayName', 'blook', 'createdAt', 'xp', 'coins', 'owned', 'customs', 'lastGame', 'channel', 'lastGift', 'banner', 'bio', 'metOwner', 'streak', 'lastDay', 'use', 'school', 'coinAt'])
        && progressOk()
        // the account type from the sign-up questions; an under-18 account stays one
        && request.resource.data.get('use', 'personal') in ['kid', 'personal', 'teacher']
        && (resource.data.get('use', '') != 'kid' || request.resource.data.get('use', '') == 'kid')
        && str(request.resource.data.get('school', ''), 80)
        && str(request.resource.data.get('banner', ''), 300)
        && str(request.resource.data.get('bio', ''), 160)
        && request.resource.data.get('metOwner', false) is bool
        && request.resource.data.get('streak', 0) is int && request.resource.data.get('streak', 0) <= 10000
        && str(request.resource.data.get('lastDay', ''), 10)
        && request.resource.data.get('channel', true) is bool
        && str(request.resource.data.get('lastGift', ''), 40)
        && request.resource.data.createdAt == resource.data.createdAt
        && str(request.resource.data.displayName, 30) && request.resource.data.displayName.size() > 0
        && str(request.resource.data.blook, 20)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow delete: if me(uid);
      // owner power: give coins and blooks
      allow update: if siteOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'owned'])
        && request.resource.data.get('coins', 0) is int && request.resource.data.get('coins', 0) >= 0
        && request.resource.data.get('owned', {}).size() <= 40;
    }

    // A username belongs to whoever claimed it first.
    match /usernames/{name} {
      allow read: if true;
      allow create: if account() && onlyKeys(['uid']) && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9_]{3,20}$');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ------------------------------------------------------------- quizzes
    match /quizzes/{id} {
      function quizShape() {
        let d = request.resource.data;
        return d.keys().hasOnly(['owner', 'title', 'description', 'cover', 'questions', 'questionCount', 'big', 'public',
                                 'keywords', 'authorName', 'authorUsername', 'authorBlook', 'updatedAt', 'createdAt', 'plays', 'liveAt', 'editors', 'image'])
          // a cover photo: a picture link
          && (!('image' in d) || (d.image is string && d.image.size() <= 300 && (d.image == '' || d.image.matches('^https://[^ "<>]+$'))))
          // making it together: up to 10 people, invited by a Pro owner
          && d.get('editors', []) is list && d.get('editors', []).size() <= 10
          && (d.get('editors', []).size() == 0 || pro()
              || (resource != null && d.get('editors', []) == resource.data.get('editors', [])))
          && d.get('liveAt', 0) is int
          // free accounts: a newly published quiz goes live 3 days or more later
          // (it was checked automatically); a quiz already live stays live; Pro at once
          && (!d.public || pro()
              || d.get('liveAt', 0) >= request.time.toMillis() + 255600000
              || (resource != null && resource.data.public == true && d.get('liveAt', 0) == resource.data.get('liveAt', 0)))
          && d.owner == request.auth.uid
          && str(d.title, 80) && d.title.size() > 0
          && str(d.description, 280)
          && d.cover is int
          && d.questions is list && d.questions.size() <= 100
          && d.questionCount == d.questions.size()
          && d.public is bool
          // the verified badge counts only published quizzes of 5+ questions
          && d.big == (d.public && d.questions.size() >= 5)
          && (!d.public || d.questions.size() >= 3)
          && d.keywords is list && d.keywords.size() <= 80
          && d.updatedAt == request.time
          // the author line must be the author's own profile
          && d.authorUsername == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username;
      }

      function editor() { return signedIn() && request.auth.uid in resource.data.get('editors', []); }

      allow read: if resource.data.public == true || (signedIn() && resource.data.owner == request.auth.uid) || siteOwner() || editor();
      // someone invited to make it together: the content only, never the
      // owner, the author line, who can edit, or whether it is published
      allow update: if account() && !banned() && editor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'cover', 'questions', 'questionCount', 'big', 'keywords', 'updatedAt', 'image'])
        && str(request.resource.data.title, 80) && request.resource.data.title.size() > 0
        && str(request.resource.data.description, 280)
        && request.resource.data.cover is int
        && request.resource.data.questions is list && request.resource.data.questions.size() <= 100
        && request.resource.data.questionCount == request.resource.data.questions.size()
        && request.resource.data.big == (resource.data.public && request.resource.data.questions.size() >= 5)
        && (!resource.data.public || request.resource.data.questions.size() >= 3)
        && request.resource.data.keywords is list && request.resource.data.keywords.size() <= 80
        && request.resource.data.updatedAt == request.time;
      allow create: if account() && !banned() && quizShape()
        && request.resource.data.plays == 0 && request.resource.data.createdAt == request.time;
      allow update: if account() && !banned() && resource.data.owner == request.auth.uid && quizShape()
        && request.resource.data.plays == resource.data.plays
        && request.resource.data.createdAt == resource.data.createdAt;
      // anyone with an account who hosts it adds exactly one play
      allow update: if account() && resource.data.public == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plays'])
        && request.resource.data.plays == resource.data.plays + 1;
      // owner power: unpublish anyone's quiz
      allow update: if siteOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['public', 'big'])
        && request.resource.data.public == false && request.resource.data.big == false;
      allow delete: if signedIn() && (resource.data.owner == request.auth.uid || siteOwner());

      // The answers. Players (guests) can never read them; accounts can when
      // the quiz is published, because hosting a quiz needs its answers.
      match /private/{doc} {
        function quizEditor() {
          return signedIn() && request.auth.uid in get(/databases/$(database)/documents/quizzes/$(id)).data.get('editors', []);
        }
        allow read: if signedIn() && (
          resource.data.owner == request.auth.uid || siteOwner() || quizEditor() ||
          (account() && get(/databases/$(database)/documents/quizzes/$(id)).data.public == true));
        // collaborators save the answers too; the key stays the owner's
        allow update: if account() && doc == 'key' && quizEditor()
          && request.resource.data.keys().hasOnly(['owner', 'answers'])
          && request.resource.data.owner == resource.data.owner
          && str(request.resource.data.answers, 200000);
        allow create, update: if account() && doc == 'key'
          && request.resource.data.keys().hasOnly(['owner', 'answers'])
          && request.resource.data.owner == request.auth.uid
          && str(request.resource.data.answers, 200000)
          && (!exists(/databases/$(database)/documents/quizzes/$(id))
              || get(/databases/$(database)/documents/quizzes/$(id)).data.owner == request.auth.uid)
          && (resource == null || resource.data.owner == request.auth.uid);
        allow delete: if signedIn() && (resource.data.owner == request.auth.uid || siteOwner());
      }
    }

    // ------------------------------------------------------------ channels
    // follows/{me_them}: I follow their channel. Anyone can count followers;
    // only you can follow or unfollow, and never yourself.
    match /follows/{id} {
      allow read: if true;
      allow create: if account() && onlyKeys(['from', 'to', 'at'])
        && request.resource.data.from == request.auth.uid
        && str(request.resource.data.to, 40) && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.at == request.time;
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }

    // ------------------------------------------------------------- reports
    match /reports/{id} {
      allow read, delete: if signedIn() && resource.data.owner == request.auth.uid;
      allow create: if account() && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['owner', 'quizId', 'quizTitle', 'mode', 'pin', 'players', 'at'])
        && request.resource.data.players is list && request.resource.data.players.size() <= 60
        && request.resource.data.at == request.time;
      allow update: if false;
    }

    // ---------------------------------------------------------- owner only
    // site-wide settings: the announcement banner, the owner's picks, special events
    match /site/{doc} {
      allow read: if true;
      allow write: if siteOwner() && doc in ['announce', 'featured', 'event'];
    }
    // accounts the owner has stopped from publishing
    match /bans/{uid} {
      allow read: if true;
      allow write: if siteOwner() && uid != request.auth.uid;
    }
    // Presentation+ decks: Pro members only; private to their owner
    match /decks/{did} {
      allow read: if signedIn() && resource.data.owner == request.auth.uid;
      allow create, update: if account() && pro() && request.resource.data.owner == request.auth.uid
        && (resource == null || resource.data.owner == request.auth.uid)
        && request.resource.data.keys().hasOnly(['owner', 'title', 'slides', 'updatedAt'])
        && str(request.resource.data.title, 80)
        && request.resource.data.slides is list && request.resource.data.slides.size() <= 40;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }

    // Homework: a teacher sets a quiz with a due date; students hand in once
    match /homework/{hid} {
      allow read: if true;
      allow create: if account() && request.resource.data.owner == request.auth.uid
        && onlyKeys(['owner', 'ownerName', 'quizId', 'quizTitle', 'title', 'dueAt', 'createdAt'])
        && str(request.resource.data.ownerName, 30) && str(request.resource.data.quizId, 60)
        && str(request.resource.data.quizTitle, 80) && str(request.resource.data.title, 80)
        && request.resource.data.dueAt is int && request.resource.data.dueAt > request.time.toMillis()
        && request.resource.data.dueAt < request.time.toMillis() + 2678400000
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
      match /results/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid
          || get(/databases/$(database)/documents/homework/$(hid)).data.owner == request.auth.uid);
        allow create: if me(uid) && account()
          && onlyKeys(['name', 'score', 'right', 'total', 'at'])
          && str(request.resource.data.name, 30)
          && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 200000
          && request.resource.data.right is int && request.resource.data.total is int
          && request.resource.data.right >= 0 && request.resource.data.right <= request.resource.data.total && request.resource.data.total <= 200
          && request.resource.data.at == request.time
          && get(/databases/$(database)/documents/homework/$(hid)).data.dueAt > request.time.toMillis();
      }
    }

    // ------------------------------------------------------------ classes
    // How someone found Quickzy and their age: private to them (and the owner)
    match /about/{uid} {
      allow read: if me(uid) || siteOwner();
      allow create, update: if me(uid) && account()
        && onlyKeys(['heard', 'age', 'at'])
        && str(request.resource.data.heard, 40)
        && request.resource.data.age is int && request.resource.data.age >= 4 && request.resource.data.age <= 120
        && request.resource.data.at == request.time;
      allow delete: if me(uid);
    }

    // A class code points at its class; codes are unique because each is a document
    match /classcodes/{code} {
      allow get: if account();
      allow create: if account() && onlyKeys(['cid', 'owner'])
        && code.matches('^[A-Z0-9]{4,10}$')
        && request.resource.data.owner == request.auth.uid
        && getAfter(/databases/$(database)/documents/classes/$(request.resource.data.cid)).data.code == code
        && (getAfter(/databases/$(database)/documents/classes/$(request.resource.data.cid)).data.owner == request.auth.uid
            || request.auth.uid in getAfter(/databases/$(database)/documents/classes/$(request.resource.data.cid)).data.get('teachers', []));
      allow delete: if signedIn() && (resource.data.owner == request.auth.uid
        || get(/databases/$(database)/documents/classes/$(resource.data.cid)).data.owner == request.auth.uid
        || request.auth.uid in get(/databases/$(database)/documents/classes/$(resource.data.cid)).data.get('teachers', []));
    }

    // Classes: a teacher makes one, students join with its code
    match /classes/{cid} {
      function teacherAccount() {
        return siteOwner() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('use', '') == 'teacher';
      }
      function teaches(c) { return signedIn() && (c.owner == request.auth.uid || request.auth.uid in c.get('teachers', [])); }
      function inIt(c) { return teaches(c) || (signedIn() && request.auth.uid in c.get('members', [])); }
      function cls() { return get(/databases/$(database)/documents/classes/$(cid)).data; }
      function codeOk(d) {
        return d.code is string && existsAfter(/databases/$(database)/documents/classcodes/$(d.code))
          && getAfter(/databases/$(database)/documents/classcodes/$(d.code)).data.cid == cid;
      }

      // the id is only known from its code or by being in it
      allow get: if account();
      allow list: if account() && (resource.data.owner == request.auth.uid
        || request.auth.uid in resource.data.members || request.auth.uid in resource.data.teachers);
      allow create: if account() && !banned() && teacherAccount()
        && (cid == request.auth.uid + '_1' || cid == request.auth.uid + '_2' || pro())
        && onlyKeys(['owner', 'ownerName', 'name', 'school', 'code', 'members', 'teachers', 'color', 'createdAt'])
        && request.resource.data.owner == request.auth.uid
        && str(request.resource.data.ownerName, 30)
        && str(request.resource.data.name, 60) && request.resource.data.name.size() > 0
        && str(request.resource.data.school, 80)
        && request.resource.data.members == [] && request.resource.data.teachers == []
        && request.resource.data.color is int
        && request.resource.data.createdAt == request.time
        && codeOk(request.resource.data);
      // teachers run it; only the owner chooses the other teachers
      allow update: if account() && teaches(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'school', 'code', 'members', 'teachers', 'color'])
        && (resource.data.owner == request.auth.uid || request.resource.data.teachers == resource.data.teachers)
        && request.resource.data.owner == resource.data.owner
        && str(request.resource.data.name, 60) && request.resource.data.name.size() > 0
        && str(request.resource.data.school, 80)
        && request.resource.data.members is list
        && (request.resource.data.members.size() <= resource.data.members.size() || roomFor(resource.data.owner, request.resource.data.members.size()))
        && request.resource.data.teachers is list && request.resource.data.teachers.size() <= 10
        && (request.resource.data.code == resource.data.code || codeOk(request.resource.data));
      // a student joins (with the code, checked on their people entry) ...
      allow update: if account()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.members.hasAll(resource.data.members)
        && request.auth.uid in request.resource.data.members
        && roomFor(resource.data.owner, request.resource.data.members.size())
        && existsAfter(/databases/$(database)/documents/classes/$(cid)/people/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/classes/$(cid)/people/$(request.auth.uid)).data.get('code', '') == resource.data.code;
      // ... or leaves
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.auth.uid in resource.data.members
        && !(request.auth.uid in request.resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() - 1
        && resource.data.members.hasAll(request.resource.data.members);
      allow delete: if signedIn() && (resource.data.owner == request.auth.uid || siteOwner());

      match /people/{uid} {
        function personOk() {
          let d = request.resource.data;
          return d.keys().hasOnly(['name', 'username', 'blook', 'role', 'code', 'at'])
            && str(d.name, 30) && str(d.username, 20) && str(d.blook, 20)
            && d.role in ['student', 'teacher'] && d.at == request.time;
        }
        allow read: if inIt(cls());
        // joining yourself needs the class code
        allow create: if me(uid) && account() && personOk()
          && request.resource.data.role == 'student'
          && request.resource.data.code == cls().code;
        // teachers add and remove people
        allow create, update: if account() && teaches(cls()) && personOk()
          && (request.resource.data.role == 'student' || cls().owner == request.auth.uid);
        allow delete: if signedIn() && (request.auth.uid == uid || teaches(cls()));
      }

      match /posts/{pid} {
        allow read: if inIt(cls());
        allow create: if account() && !banned() && teaches(cls())
          && onlyKeys(['by', 'byName', 'kind', 'text', 'pin', 'title', 'hwId', 'dueAt', 'options', 'answer', 'at'])
          && request.resource.data.by == request.auth.uid
          && str(request.resource.data.byName, 30)
          && request.resource.data.kind in ['note', 'game', 'homework', 'question']
          && str(request.resource.data.text, 1000)
          && str(request.resource.data.get('pin', ''), 6)
          && str(request.resource.data.get('title', ''), 80)
          && str(request.resource.data.get('hwId', ''), 60)
          && request.resource.data.get('dueAt', 0) is int
          && request.resource.data.get('options', []) is list && request.resource.data.get('options', []).size() <= 4
          && request.resource.data.get('answer', 0) is int
          && request.resource.data.at == request.time;
        allow delete: if signedIn() && teaches(cls());

        // the one-question quiz in an announcement: one answer each
        match /answers/{uid} {
          allow read: if signedIn() && (request.auth.uid == uid || teaches(cls()));
          allow create: if me(uid) && account() && inIt(cls())
            && onlyKeys(['name', 'choice', 'at'])
            && str(request.resource.data.name, 30)
            && request.resource.data.choice is int && request.resource.data.choice >= 0 && request.resource.data.choice < 4
            && request.resource.data.at == request.time
            && get(/databases/$(database)/documents/classes/$(cid)/posts/$(pid)).data.kind == 'question';
        }
      }
    }

    // Invites: a brand-new account says who invited it, once; the inviter
    // marks it claimed when they collect the reward
    match /referrals/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || resource.data.by == request.auth.uid);
      allow create: if me(uid) && account()
        && onlyKeys(['by', 'name', 'at', 'claimed'])
        && str(request.resource.data.by, 40) && request.resource.data.by != uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.by))
        && str(request.resource.data.name, 30)
        && request.resource.data.at == request.time
        && request.resource.data.claimed == false
        && get(/databases/$(database)/documents/users/$(uid)).data.createdAt > request.time - duration.value(1, 'd');
      allow update: if signedIn() && resource.data.by == request.auth.uid && resource.data.claimed == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed'])
        && request.resource.data.claimed == true;
      allow delete: if me(uid);
    }
    // Pro memberships: only the owner (later, the payment system) gives them
    match /members/{uid} {
      allow read: if true;
      allow write: if siteOwner();
    }
    // blue checks the owner gives by hand
    match /badges/{uid} {
      allow read: if true;
      allow write: if siteOwner();
    }

    // everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
